<UserControl x:Class="DACDT_2026.Views.Panels.SidebarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource PanelBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Navigation" Style="{StaticResource PanelTitleStyle}"/>
                <TextBlock Text="Operational views" Style="{StaticResource PanelSubtitleStyle}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                <Button Content="Dashboard" Command="{Binding SwitchViewCommand}" CommandParameter="control" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,7"/>
                <Button Content="DXF / GCODE Run" Command="{Binding SwitchViewCommand}" CommandParameter="dxf" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,7"/>
                <Button Content="Telemetry" Command="{Binding SwitchViewCommand}" CommandParameter="telemetry" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,7"/>
                <Button Content="Logs" Command="{Binding SwitchViewCommand}" CommandParameter="logs" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,7"/>
                <Button Content="System Settings" Command="{Binding SwitchViewCommand}" CommandParameter="settings" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,7"/>
                <Button Content="Help" Command="{Binding SwitchViewCommand}" CommandParameter="help" Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>

            <Border Grid.Row="2"
                    Background="{StaticResource PanelAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10"
                    Margin="0,18,0,12"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Manual Jog" Style="{StaticResource PanelTitleStyle}"/>
                    <TextBlock Text="M3000 - M3005 hold control" Style="{StaticResource PanelSubtitleStyle}"/>

                    <Grid Width="164" Height="128" Margin="0,14,0,0" HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Row="0" Grid.Column="1" Content="Up" Tag="2" Style="{StaticResource PrimaryButtonStyle}" PreviewMouseDown="JogButton_PreviewMouseDown" PreviewMouseUp="JogButton_PreviewMouseUp" MouseLeave="JogButton_MouseLeave"/>
                        <Button Grid.Row="1" Grid.Column="0" Content="Left" Tag="1" Style="{StaticResource PrimaryButtonStyle}" PreviewMouseDown="JogButton_PreviewMouseDown" PreviewMouseUp="JogButton_PreviewMouseUp" MouseLeave="JogButton_MouseLeave"/>
                        <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="3">
                            <TextBlock Text="XY" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontWeight="Bold"/>
                        </Border>
                        <Button Grid.Row="1" Grid.Column="2" Content="Right" Tag="0" Style="{StaticResource PrimaryButtonStyle}" PreviewMouseDown="JogButton_PreviewMouseDown" PreviewMouseUp="JogButton_PreviewMouseUp" MouseLeave="JogButton_MouseLeave"/>
                        <Button Grid.Row="2" Grid.Column="1" Content="Down" Tag="3" Style="{StaticResource PrimaryButtonStyle}" PreviewMouseDown="JogButton_PreviewMouseDown" PreviewMouseUp="JogButton_PreviewMouseUp" MouseLeave="JogButton_MouseLeave"/>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Z+" Tag="4" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,4,0" PreviewMouseDown="JogButton_PreviewMouseDown" PreviewMouseUp="JogButton_PreviewMouseUp" MouseLeave="JogButton_MouseLeave"/>
                        <Button Grid.Column="1" Content="Z-" Tag="5" Style="{StaticResource PrimaryButtonStyle}" Margin="4,0,0,0" PreviewMouseDown="JogButton_PreviewMouseDown" PreviewMouseUp="JogButton_PreviewMouseUp" MouseLeave="JogButton_MouseLeave"/>
                    </Grid>

                    <TextBlock Text="Jog speed D406 (mm/min)" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4" FontSize="11"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="62"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding JogSpeedInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Content="SET" Command="{Binding SetJogSpeedCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                    </Grid>
                    <TextBlock Text="{Binding JogSpeedD406, StringFormat=Live: {0:F3} mm/min}"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,6,0,0"
                               FontSize="11"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="3">
                <Button Content="EMERGENCY STOP" Command="{Binding EmergencyStopCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0,0,0,8"/>
                <Button Content="EXIT APP" Command="{Binding ExitCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
