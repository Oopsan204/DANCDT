<UserControl x:Class="DACDT_2026.Views.DxfRunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DACDT_2026">
    <UserControl.Resources>
        <local:InverseZoomStrokeThicknessConverter x:Key="InverseZoomStrokeThicknessConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource PanelBorderStyle}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding FilePath}" IsReadOnly="True" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding FileName}" IsReadOnly="True" Margin="0,0,8,0"/>
                <WrapPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="New" Command="{Binding NewGcodeCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="Open" Command="{Binding OpenDxfCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="HOME" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Tag="home" PreviewMouseDown="HoldButton_PreviewMouseDown" PreviewMouseUp="HoldButton_PreviewMouseUp" MouseLeave="HoldButton_MouseLeave"/>
                    <Button Content="RESET" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Tag="reset" PreviewMouseDown="HoldButton_PreviewMouseDown" PreviewMouseUp="HoldButton_PreviewMouseUp" MouseLeave="HoldButton_MouseLeave"/>
                    <Button Content="RUN" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0" Tag="start" PreviewMouseDown="HoldButton_PreviewMouseDown" PreviewMouseUp="HoldButton_PreviewMouseUp" MouseLeave="HoldButton_MouseLeave"/>
                    <Button Content="CONTINUE" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Tag="continue" PreviewMouseDown="HoldButton_PreviewMouseDown" PreviewMouseUp="HoldButton_PreviewMouseUp" MouseLeave="HoldButton_MouseLeave"/>
                    <Button Content="PAUSE" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Tag="pause" PreviewMouseDown="HoldButton_PreviewMouseDown" PreviewMouseUp="HoldButton_PreviewMouseUp" MouseLeave="HoldButton_MouseLeave"/>
                    <Button Content="Clear Buffer" Command="{Binding ClearBufferCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="Send CAD to PLC" Command="{Binding SendCadXCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="1.05*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="CAD Preview" Style="{StaticResource PanelTitleStyle}"/>
                        <TextBlock Text="{Binding FileKind}" Foreground="{StaticResource MutedBrush}" Margin="12,2,0,0"/>
                    </StackPanel>
                    <Border x:Name="CadViewport"
                            Grid.Row="1"
                            Background="#050A14"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="0,10,0,0"
                            ClipToBounds="True"
                            Cursor="Hand"
                            PreviewMouseWheel="CadViewport_PreviewMouseWheel"
                            MouseLeftButtonDown="CadViewport_MouseLeftButtonDown"
                            MouseLeftButtonUp="CadViewport_MouseLeftButtonUp"
                            MouseMove="CadViewport_MouseMove"
                            MouseLeave="CadViewport_MouseLeave">
                        <Viewbox Stretch="Uniform">
                            <Canvas x:Name="CadSurface" Width="1000" Height="560" ClipToBounds="True">
                                <Rectangle Width="1000" Height="560" Fill="#050A14"/>
                                <Canvas x:Name="CadContent">
                                    <Canvas.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="CadZoomTransform" ScaleX="1" ScaleY="1"/>
                                            <TranslateTransform x:Name="CadPanTransform" X="0" Y="0"/>
                                        </TransformGroup>
                                    </Canvas.RenderTransform>

                                    <ItemsControl ItemsSource="{Binding CadLimitAreas}" IsHitTestVisible="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Polygon Points="{Binding Points}"
                                                         Fill="{Binding Fill}"
                                                         Stroke="{Binding Stroke}"
                                                         StrokeDashArray="{Binding StrokeDashArray}">
                                                    <Polygon.StrokeThickness>
                                                        <MultiBinding Converter="{StaticResource InverseZoomStrokeThicknessConverter}">
                                                            <Binding Path="StrokeThickness"/>
                                                            <Binding RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" Path="CadDisplayZoom"/>
                                                        </MultiBinding>
                                                    </Polygon.StrokeThickness>
                                                </Polygon>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding CadAxisLines}" IsHitTestVisible="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Line X1="{Binding X1}"
                                                      Y1="{Binding Y1}"
                                                      X2="{Binding X2}"
                                                      Y2="{Binding Y2}"
                                                      Stroke="{Binding Stroke}"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Opacity="{Binding Opacity}">
                                                    <Line.StrokeThickness>
                                                        <MultiBinding Converter="{StaticResource InverseZoomStrokeThicknessConverter}">
                                                            <Binding Path="StrokeThickness"/>
                                                            <Binding RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" Path="CadDisplayZoom"/>
                                                        </MultiBinding>
                                                    </Line.StrokeThickness>
                                                </Line>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding CadPrimitives}" IsHitTestVisible="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Polyline Points="{Binding Points}"
                                                          Stroke="{Binding Stroke}"
                                                          StrokeLineJoin="Round"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round">
                                                    <Polyline.StrokeThickness>
                                                        <MultiBinding Converter="{StaticResource InverseZoomStrokeThicknessConverter}">
                                                            <Binding Path="StrokeThickness"/>
                                                            <Binding RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" Path="CadDisplayZoom"/>
                                                        </MultiBinding>
                                                    </Polyline.StrokeThickness>
                                                </Polyline>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding CadAxisLabels}" IsHitTestVisible="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Text}"
                                                           Foreground="{Binding Foreground}"
                                                           FontSize="14"
                                                           FontWeight="Bold"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </Canvas>
                        </Viewbox>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="G-code Editor" Style="{StaticResource PanelTitleStyle}"/>
                    <TextBox Grid.Row="1"
                             Text="{Binding RawGcodeText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             FontFamily="Consolas"
                             FontSize="12"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"
                             Margin="0,10,0,8"
                             VerticalContentAlignment="Top"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Preview" Command="{Binding PreviewGcodeCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                        <Button Content="Save G-code" Command="{Binding SaveGcodeCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Process Table" Style="{StaticResource PanelTitleStyle}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ProgressBar Width="150" Height="10" Value="{Binding ProgressPercent}" Maximum="100" Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ProcessRows}"
                              AutoGenerateColumns="False"
                              Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Key}" Width="70"/>
                            <DataGridTextColumn Header="Motion type" Binding="{Binding MotionType}" Width="*"/>
                            <DataGridTextColumn Header="M" Binding="{Binding MCodeValue}" Width="55"/>
                            <DataGridTextColumn Header="Dwell" Binding="{Binding Dwell}" Width="75"/>
                            <DataGridTextColumn Header="Speed" Binding="{Binding Speed}" Width="85"/>
                            <DataGridTextColumn Header="End X;Y" Binding="{Binding EndCoordinate}" Width="140"/>
                            <DataGridTextColumn Header="Center X;Y" Binding="{Binding CenterCoordinate}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Geometry Data" Style="{StaticResource PanelTitleStyle}"/>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding GeometryRows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              ScrollViewer.CanContentScroll="True"
                              HorizontalScrollBarVisibility="Auto"
                              Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="No." Binding="{Binding Index}" Width="60"/>
                            <DataGridTextColumn Header="Line type" Binding="{Binding LineType}" Width="105"/>
                            <DataGridTextColumn Header="Start X" Binding="{Binding StartX}" Width="85"/>
                            <DataGridTextColumn Header="Start Y" Binding="{Binding StartY}" Width="85"/>
                            <DataGridTextColumn Header="End X" Binding="{Binding EndX}" Width="85"/>
                            <DataGridTextColumn Header="End Y" Binding="{Binding EndY}" Width="85"/>
                            <DataGridTextColumn Header="Center X" Binding="{Binding CenterX}" Width="85"/>
                            <DataGridTextColumn Header="Center Y" Binding="{Binding CenterY}" Width="85"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
