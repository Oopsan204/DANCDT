<UserControl x:Class="DACDT_2026.Views.TelemetryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource PanelBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding TelemetryAddressInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding TelemetryLengthInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Add Register" Command="{Binding AddTelemetryRegisterCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="Add Buffer" Command="{Binding AddTelemetryBufferCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Live Registers" Style="{StaticResource PanelTitleStyle}"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding TelemetryRegisters}" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Register" Binding="{Binding Register}" Width="*"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="120"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Buffer Blocks" Style="{StaticResource PanelTitleStyle}"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding TelemetryBuffers}" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="150"/>
                            <DataGridTextColumn Header="Values" Binding="{Binding Values}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding WriteAddressInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding WriteValueInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="Write Data" Command="{Binding WriteBufferCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
