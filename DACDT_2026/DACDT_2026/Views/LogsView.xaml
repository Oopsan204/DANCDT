<UserControl x:Class="DACDT_2026.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource PanelBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Logs" Style="{StaticResource PanelTitleStyle}"/>
                    <TextBlock Text="PLC read/write transactions" Style="{StaticResource PanelSubtitleStyle}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Clear" Command="{Binding ClearLogsCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
            </Grid>

            <DataGrid Grid.Row="1" ItemsSource="{Binding Logs}" Margin="0,12,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="120"/>
                    <DataGridTextColumn Header="Dir" Binding="{Binding Direction}" Width="80"/>
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="130"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="130"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
