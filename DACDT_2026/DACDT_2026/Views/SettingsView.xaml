<UserControl x:Class="DACDT_2026.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.12*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="DXF Offset &amp; Speed" Style="{StaticResource PanelTitleStyle}"/>
                        <TextBlock Text="Parameters applied to DXF paths" Style="{StaticResource PanelSubtitleStyle}"/>
                        <UniformGrid Columns="2" Margin="0,14,0,0">
                            <StackPanel Margin="0,0,6,8">
                                <TextBlock Text="Offset X (mm)" Foreground="{StaticResource MutedBrush}"/>
                                <TextBox Text="{Binding OffsetXInput, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="6,0,0,8">
                                <TextBlock Text="Offset Y (mm)" Foreground="{StaticResource MutedBrush}"/>
                                <TextBox Text="{Binding OffsetYInput, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,6,8">
                                <TextBlock Text="Speed M03" Foreground="{StaticResource MutedBrush}"/>
                                <TextBox Text="{Binding GlobalSpeedM3Input, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="6,0,0,8">
                                <TextBlock Text="Speed M04" Foreground="{StaticResource MutedBrush}"/>
                                <TextBox Text="{Binding GlobalSpeedInput, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,6,8">
                                <TextBlock Text="Dwell M03 (ms)" Foreground="{StaticResource MutedBrush}"/>
                                <TextBox Text="{Binding GlobalDwellM3Input, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="6,0,0,8">
                                <TextBlock Text="Dwell M04 (ms)" Foreground="{StaticResource MutedBrush}"/>
                                <TextBox Text="{Binding GlobalDwellM4Input, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </UniformGrid>
                        <Button Content="Apply DXF Settings" Command="{Binding ApplyDxfSettingsCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Machine Config &amp; Workspace" Style="{StaticResource PanelTitleStyle}"/>
                        <TextBlock Text="Rapid speed and drawing boundary" Style="{StaticResource PanelSubtitleStyle}"/>
                        <TextBlock Text="G00 rapid speed (mm/min)" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding RapidSpeedInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Apply Speed" Command="{Binding SetG0SpeedCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                        </Grid>
                        <UniformGrid Columns="2" Margin="0,14,0,0">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Workspace X (mm)" Foreground="{StaticResource MutedBrush}"/>
                                <TextBox Text="{Binding WorkspaceWidthInput, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Workspace Y (mm)" Foreground="{StaticResource MutedBrush}"/>
                                <TextBox Text="{Binding WorkspaceHeightInput, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </UniformGrid>
                        <Button Content="Apply Workspace" Command="{Binding SetWorkspaceCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="G54-G59 WCS Offsets" Style="{StaticResource PanelTitleStyle}"/>
                        <TextBlock Text="Offsets added to G-code coordinates" Style="{StaticResource PanelSubtitleStyle}"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>

                            <DataGrid x:Name="WcsGrid"
                                      ItemsSource="{Binding WcsOffsets}"
                                      SelectedValue="{Binding ActiveWcs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Name"
                                      SelectionChanged="WcsGrid_SelectionChanged"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      Height="220"
                                      Margin="0,0,12,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="WCS" Binding="{Binding Name}" IsReadOnly="True" Width="80"/>
                                    <DataGridTextColumn Header="Offset X (mm)" Binding="{Binding OffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridTextColumn Header="Offset Y (mm)" Binding="{Binding OffsetY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Active WCS" Foreground="{StaticResource MutedBrush}"/>
                                <Border Background="{StaticResource PanelAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,9"
                                        Margin="0,4,0,12">
                                    <TextBlock Text="{Binding ActiveWcs}" FontSize="18" FontWeight="SemiBold"/>
                                </Border>
                                <Button Content="Apply WCS Table"
                                        Command="{Binding SetWcsCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Configuration Profiles" Style="{StaticResource PanelTitleStyle}"/>
                        <TextBlock Text="Save, load or delete settings profiles" Style="{StaticResource PanelSubtitleStyle}"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ProfileNameInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Content="Save" Command="{Binding SaveProfileCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0"/>
                            <Button Grid.Column="3" Content="Load" Command="{Binding LoadProfileCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                            <Button Grid.Column="4" Content="Delete" Command="{Binding DeleteProfileCommand}" Style="{StaticResource DangerButtonStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
