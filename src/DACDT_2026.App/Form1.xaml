<Window x:Class="DACDT_2026.Form1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DACDT_2026.Views"
        xmlns:panels="clr-namespace:DACDT_2026.Views.Panels"
        xmlns:local="clr-namespace:DACDT_2026"
        Title="DACDT 2026"
        Width="1440"
        Height="860"
        MinWidth="1024"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource BgBrush}"
        Icon="app_icon.png">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <local:BoolToStatusBrushConverter x:Key="BoolToStatusBrushConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="6"
          UseLayoutRounding="True"
          SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <panels:AppHeaderControl Grid.Row="0"
                                 Grid.Column="0"
                                 Grid.ColumnSpan="2"
                                 Margin="0,0,0,6"/>

        <panels:SidebarControl Grid.Row="1"
                               Grid.Column="0"
                               Margin="0,0,6,0"/>

        <Grid Grid.Row="1" Grid.Column="1">
            <views:DashboardView Visibility="{Binding IsControlView, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <views:DxfRunView Visibility="{Binding IsDxfView, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <views:MonitorView Visibility="{Binding IsMonitorView, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <views:TelemetryView Visibility="{Binding IsTelemetryView, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <views:LogsView Visibility="{Binding IsLogsView, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <views:SettingsView Visibility="{Binding IsSettingsView, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <views:HelpView Visibility="{Binding IsHelpView, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</Window>
