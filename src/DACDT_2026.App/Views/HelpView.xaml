<UserControl x:Class="DACDT_2026.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DACDT_2026;component/Views/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Border Style="{StaticResource PanelBorderStyle}"
                MaxWidth="1180"
                HorizontalAlignment="Left"
                Padding="22">
            <StackPanel>
                <TextBlock Text="HƯỚNG DẪN SỬ DỤNG"
                           Style="{StaticResource PanelTitleStyle}"
                           FontSize="24"/>
                <TextBlock Text="Hướng dẫn vận hành hệ thống DACDT 2026"
                           Style="{StaticResource PanelSubtitleStyle}"
                           Margin="0,4,0,14"/>

                <Border Background="{DynamicResource HelpCalloutBrush}"
                        BorderBrush="{DynamicResource HelpCalloutBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,0,16">
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedBrush}"
                               LineHeight="20">
                        Đọc các bước an toàn trước khi vận hành. Luôn kiểm tra vùng làm việc, trạng thái PLC,
                        đường chạy và vị trí nút EMERGENCY STOP trước khi cho máy chạy.
                    </TextBlock>
                </Border>

                <TextBlock Text="MỤC LỤC NHANH"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,4,0,8"/>
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}"
                           LineHeight="22"
                           Margin="0,0,0,18">
                    1. An toàn trước khi vận hành&#x0a;
                    2. Khởi động và kết nối PLC&#x0a;
                    3. Jog tay, HOME và RESET&#x0a;
                    4. Mở và kiểm tra file DXF/G-code&#x0a;
                    5. Gửi dữ liệu và chạy chương trình&#x0a;
                    6. RUN / PAUSE / CONTINUE / STOP&#x0a;
                    7. Camera, Logs và Settings&#x0a;
                    8. Thoát app, xử lý lỗi và checklist
                </TextBlock>

                <TextBlock Text="1. An toàn trước khi vận hành"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,12,0,6"/>
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}"
                           LineHeight="22">
                    Kiểm tra nguồn máy, vùng làm việc, vật cản, gá đặt phôi và hành trình các trục. Đảm bảo người vận hành
                    đứng ngoài vùng nguy hiểm và biết vị trí nút EMERGENCY STOP. Khi có nguy hiểm cơ khí, nhấn EMERGENCY STOP ngay.
                </TextBlock>
                <Border Background="{DynamicResource HelpCodeBrush}"
                        BorderBrush="{DynamicResource HelpCodeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,10,0,0">
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{DynamicResource HelpWarningTextBrush}"
                               LineHeight="20">
                        Không đưa tay hoặc vật lạ vào vùng chạy khi máy đang hoạt động. STOP là dừng theo quy trình;
                        EMERGENCY STOP dùng cho tình huống khẩn cấp.
                    </TextBlock>
                </Border>

                <TextBlock Text="2. Khởi động và kết nối PLC"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,18,0,6"/>
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}"
                           LineHeight="22">
                    1) Bật nguồn máy và PLC.&#x0a;
                    2) Kiểm tra dây mạng và trạng thái kết nối.&#x0a;
                    3) Nhập đúng thông tin kết nối PLC theo cấu hình máy.&#x0a;
                    4) Nhấn CONNECT PLC Q và chờ trạng thái Connected/Ready.&#x0a;
                    5) Kiểm tra vị trí, tốc độ và trạng thái của các trục trước khi thao tác.
                </TextBlock>

                <TextBlock Text="3. Jog tay, HOME và RESET"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,18,0,6"/>
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}"
                           LineHeight="22">
                    Đặt tốc độ jog thấp trước khi căn chỉnh. Giữ nút jog để di chuyển và nhả nút để dừng. Dùng HOME
                    khi vùng máy an toàn để đưa trục về vị trí gốc. Chỉ dùng RESET sau khi đã xử lý nguyên nhân lỗi.
                    Không HOME hoặc jog khi có vật cản trong vùng chuyển động.
                </TextBlock>

                <TextBlock Text="4. Mở và kiểm tra file DXF/G-code"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,18,0,6"/>
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}"
                           LineHeight="22">
                    Mở tab DXF / GCODE Run và chọn file cần chạy. Hệ thống chỉ nhận đường thẳng, cung tròn và hình tròn;
                    không sử dụng spline, ellipse hoặc các dạng hình học khác. Kiểm tra bản xem trước, thứ tự đường chạy,
                    điểm bắt đầu, chiều di chuyển, kích thước vùng làm việc, tốc độ và hệ tọa độ WCS. Nếu hình vẽ, bảng lệnh
                    hoặc thông số không đúng, không gửi dữ liệu xuống PLC.
                </TextBlock>

                <TextBlock Text="5. Gửi dữ liệu và chạy chương trình"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,18,0,6"/>
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}"
                           LineHeight="22">
                    Quy trình vận hành: kết nối PLC, mở file, kiểm tra bản xem trước, kiểm tra bảng lệnh và các thông số,
                    sau đó nhấn Send CAD hoặc Send to PLC. Chờ quá trình gửi hoàn tất, quan sát trạng thái và chỉ nhấn RUN
                    khi dữ liệu đã đầy đủ. Không nhấn RUN liên tục hoặc chạy khi bảng lệnh trống.
                </TextBlock>

                <TextBlock Text="6. RUN / PAUSE / CONTINUE / STOP"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,18,0,6"/>
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}"
                           LineHeight="22">
                    RUN: bắt đầu chạy chương trình sau khi dữ liệu đã được kiểm tra.&#x0a;
                    PAUSE: tạm dừng chương trình theo quy trình của PLC.&#x0a;
                    CONTINUE: chạy tiếp sau khi đã PAUSE và xác nhận máy an toàn.&#x0a;
                    STOP: dừng chương trình theo quy trình và đưa hệ thống về trạng thái chờ.&#x0a;
                    EMERGENCY STOP: dừng khẩn cấp khi có nguy hiểm; sau đó chỉ RESET và vận hành lại khi nguyên nhân đã được xử lý.
                </TextBlock>

                <TextBlock Text="7. Camera, Logs và Settings"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,18,0,6"/>
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}"
                           LineHeight="22">
                    Monitor dùng để chọn camera, xem hình trực tiếp và ghi hình khi cần. Logs dùng để xem thao tác gần nhất,
                    trạng thái kết nối và lỗi phát sinh. Settings dùng để chỉnh các thông số vận hành như tốc độ, workspace,
                    offset và hệ tọa độ. Sau khi thay đổi, kiểm tra lại giá trị rồi nhấn Apply hoặc Save nếu có.
                </TextBlock>

                <TextBlock Text="8. Thoát app, xử lý lỗi và checklist"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,18,0,6"/>
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}"
                           LineHeight="22">
                    Khi kết thúc, dừng chương trình theo đúng quy trình, xác nhận các trục đã dừng rồi nhấn EXIT APP.
                    Nếu PLC không kết nối, kiểm tra nguồn PLC, dây mạng và thông tin kết nối. Nếu RUN không hoạt động,
                    kiểm tra dữ liệu đã gửi, bảng lệnh và cảnh báo. Nếu hình chạy sai, kiểm tra lại file, offset, WCS,
                    tốc độ và workspace.
                </TextBlock>
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}"
                           LineHeight="22"
                           Margin="0,8,0,10">
                    Checklist trước khi chạy:&#x0a;
                    □ PLC đã Connected/Ready.&#x0a;
                    □ Không có lỗi hoặc cảnh báo nguy hiểm.&#x0a;
                    □ Vùng chạy không có vật cản.&#x0a;
                    □ File và bản xem trước đúng.&#x0a;
                    □ Tốc độ, workspace và WCS đúng.&#x0a;
                    □ Bảng lệnh có dữ liệu hợp lý.&#x0a;
                    □ Người vận hành đứng ngoài vùng nguy hiểm và biết vị trí EMERGENCY STOP.
                </TextBlock>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
