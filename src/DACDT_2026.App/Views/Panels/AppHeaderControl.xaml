<UserControl x:Class="DACDT_2026.Views.Panels.AppHeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DACDT_2026">
    <Border Style="{StaticResource PanelBorderStyle}" Padding="10,7">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="146"
                        Height="44"
                        CornerRadius="8"
                        Background="White"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Padding="7,4"
                        Margin="0,0,10,0">
                    <Image Source="/Assets/aml-logo.png"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="DACDT 2026" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="Gantry Robot Control System"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="11"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="10"
                         Height="10"
                         Fill="{Binding IsConnected, Converter={StaticResource BoolToStatusBrushConverter}}"
                         Margin="0,0,8,0"/>
                <TextBlock Text="{Binding ConnectionBanner}"
                           FontWeight="SemiBold"
                           Margin="0,0,14,0"
                           VerticalAlignment="Center"/>
                <Button Content="{Binding ThemeToggleText}"
                        Command="{Binding ToggleThemeCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="82"
                        Margin="0,0,12,0"
                        ToolTip="Switch between light and dark themes"/>
                <TextBlock Text="{Binding ActiveNotice}"
                           Foreground="{DynamicResource MutedBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="480"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
