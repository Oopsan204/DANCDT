<UserControl x:Class="DACDT_2026.Views.SvgToDxfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DACDT_2026">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DACDT_2026;component/Views/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR: COMPACT FILE CONTROLS & ACTIONS -->
        <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,6" Padding="12,10">
            <Grid>
                <!-- Inputs and Actions in a clean grid -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: Source SVG & Save DXF Destination -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <!-- Source SVG File -->
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <!-- Target DXF File (Rename / Save As) -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Source SVG -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Source SVG File" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding SvgInputPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" VerticalAlignment="Center" Height="32"/>
                            <Button Grid.Column="1" Content="SELECT SVG" Command="{Binding BrowseSvgCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="32" Padding="14,0" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- Output DXF Path & Save As Dialog -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Output DXF File (Rename / Target Path)" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding SvgOutputPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" VerticalAlignment="Center" Height="32"/>
                            <Button Grid.Column="1" Content="SAVE AS..." Command="{Binding BrowseSvgOutputCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="32" Padding="16,0" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Open in CAD Run + Status Info -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Action Button: Switch straight to CAD Run View -->
                    <Button Grid.Column="0" Content="OPEN IN CAD RUN VIEW" Command="{Binding LoadConvertedDxfToRunCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="32" Padding="14,0" FontWeight="SemiBold" Margin="0,0,12,0"/>

                    <!-- Status Display -->
                    <Border Grid.Column="1" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SvgConversionStatus}" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- MAIN CONTENT: FULL CAD GEOMETRY PREVIEW VIEWPORT -->
        <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}" Margin="0" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header Toolbar: Title & Stats Badges -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Vector Preview" Style="{StaticResource PanelTitleStyle}" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock Text="(Live Vector Geometry Display)" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Stats Badges -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding HasSvgDxfPreview, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Paths: " Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SvgDxfPreviewPathCount}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Vertices: " Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SvgDxfPreviewVertexCount}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Bounds: " Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SvgDxfPreviewBoundsText}" Foreground="{DynamicResource GreenBrush}" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- CAD Canvas Viewport Container -->
                <Border Grid.Row="1" Background="{DynamicResource CadCanvasBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                    <Grid>
                        <!-- Grid Axis Guidelines Background -->
                        <Canvas IsHitTestVisible="False">
                            <Line X1="0" Y1="0" X2="3000" Y2="0" Stroke="{DynamicResource BorderSoftBrush}" StrokeThickness="0.5" Opacity="0.3"/>
                            <Line X1="0" Y1="0" X2="0" Y2="3000" Stroke="{DynamicResource BorderSoftBrush}" StrokeThickness="0.5" Opacity="0.3"/>
                        </Canvas>

                        <!-- Converted DXF / SVG Vector Render -->
                        <Viewbox Stretch="Uniform" Margin="24" Visibility="{Binding HasSvgDxfPreview, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Path Data="{Binding SvgDxfPreviewGeometry}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                        </Viewbox>

                        <!-- Empty State Viewport Placeholder -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSvgDxfPreview}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Border Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="24,18" HorizontalAlignment="Center" MaxWidth="380">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="NO SVG FILE LOADED" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Select an SVG file above to preview geometry and save as DXF." Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>

