<UserControl x:Class="DACDT_2026.Views.DxfRunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:DACDT_2026">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DACDT_2026;component/Views/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <local:BoolToStatusBrushConverter x:Key="BoolToStatusBrushConverter"/>
            <local:InverseZoomStrokeThicknessConverter x:Key="InverseZoomStrokeThicknessConverter"/>
            <local:NegativeHalfConverter x:Key="NegativeHalfConverter"/>
            <sys:Double x:Key="BaseStrokeThickness">1.0</sys:Double>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource PanelBorderStyle}" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: File & Laser Config -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Text="{Binding FilePath}" IsReadOnly="True" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="1" Text="{Binding FileName}" IsReadOnly="True" Margin="0,0,12,0" FontSize="13" FontWeight="Bold"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Laser (%):" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding LaserPowerInput, UpdateSourceTrigger=PropertyChanged}" Width="60" VerticalAlignment="Center" Margin="0,0,6,0" HorizontalContentAlignment="Center"/>
                        <Button Content="SET POWER" Command="{Binding SetLaserPowerCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="30" Padding="12,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Action Buttons Toolbar -->
                <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Group: File -->
                    <Border BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,1,0" Padding="0,0,10,0" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Import DXF" Command="{Binding ImportDxfCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="110"/>
                        </StackPanel>
                    </Border>

                    <!-- Group: PLC Transfer & Setup -->
                    <Border BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,1,0" Padding="0,0,10,0" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="HOME" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Width="80" Tag="home" PreviewMouseDown="HoldButton_PreviewMouseDown" PreviewMouseUp="HoldButton_PreviewMouseUp" MouseLeave="HoldButton_MouseLeave" LostMouseCapture="HoldButton_LostMouseCapture"/>
                            <Button Content="RESET" Style="{StaticResource SecondaryButtonStyle}" Width="80" Tag="reset" PreviewMouseDown="HoldButton_PreviewMouseDown" PreviewMouseUp="HoldButton_PreviewMouseUp" MouseLeave="HoldButton_MouseLeave" LostMouseCapture="HoldButton_LostMouseCapture"/>
                        </StackPanel>
                    </Border>

                    <!-- Group: Execution -->
                    <Border BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,1,0" Padding="0,0,10,0" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="RUN" IsEnabled="{Binding IsStartActionEnabled}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0" Width="80" Tag="start" PreviewMouseDown="HoldButton_PreviewMouseDown" PreviewMouseUp="HoldButton_PreviewMouseUp" MouseLeave="HoldButton_MouseLeave" LostMouseCapture="HoldButton_LostMouseCapture"/>
                            <Button Content="PAUSE" IsEnabled="{Binding IsPauseContinueEnabled}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Width="80" Tag="pause" PreviewMouseDown="HoldButton_PreviewMouseDown" PreviewMouseUp="HoldButton_PreviewMouseUp" MouseLeave="HoldButton_MouseLeave" LostMouseCapture="HoldButton_LostMouseCapture"/>
                            <Button Content="CONTINUE" IsEnabled="{Binding IsPauseContinueEnabled}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Width="90" Tag="continue" PreviewMouseDown="HoldButton_PreviewMouseDown" PreviewMouseUp="HoldButton_PreviewMouseUp" MouseLeave="HoldButton_MouseLeave" LostMouseCapture="HoldButton_LostMouseCapture"/>
                            <Button Content="STOP" Command="{Binding StopRunCommand}" Style="{StaticResource DangerButtonStyle}" Width="80"/>
                        </StackPanel>
                    </Border>

                    <!-- Group: Utilities -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Test Area" Command="{Binding TestEngraveAreaCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0" Width="120"/>
                        <Button Content="Clear Buffer" Command="{Binding ClearBufferCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0,0,6,0" Width="100"/>
                        <Button Content="Export QD75" Command="{Binding ExportQD75Command}" Style="{StaticResource SecondaryButtonStyle}" Width="100"/>
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="CAD Preview" Style="{StaticResource PanelTitleStyle}"/>
                        <TextBlock Text="{Binding FileKind}" Foreground="{DynamicResource MutedBrush}" Margin="12,2,0,0"/>
                        <Border Width="14" Height="3" Background="DodgerBlue" Margin="14,10,4,0"/>
                        <TextBlock Text="Engrave" Foreground="{DynamicResource MutedBrush}" Margin="0,2,8,0"/>
                        <Border Width="14" Height="3" Background="OrangeRed" Margin="0,10,4,0"/>
                        <TextBlock Text="Cut" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border x:Name="CadViewport"
                            Grid.Row="1"
                            Background="{DynamicResource CadCanvasBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="0,8,0,0"
                            ClipToBounds="True"
                            Cursor="Hand"
                            PreviewMouseWheel="CadViewport_PreviewMouseWheel"
                            MouseLeftButtonDown="CadViewport_MouseLeftButtonDown"
                            MouseLeftButtonUp="CadViewport_MouseLeftButtonUp"
                            MouseMove="CadViewport_MouseMove"
                            MouseLeave="CadViewport_MouseLeave"
                            PreviewTouchDown="CadViewport_PreviewTouchDown"
                            PreviewTouchMove="CadViewport_PreviewTouchMove"
                            PreviewTouchUp="CadViewport_PreviewTouchUp"
                            LostTouchCapture="CadViewport_LostTouchCapture">
                        <Viewbox x:Name="CadPreviewViewbox" Stretch="Uniform" ClipToBounds="False">
                            <Canvas x:Name="CadSurface" Width="1000" Height="620" ClipToBounds="False">
                                <Rectangle Width="1000" Height="620" Fill="{DynamicResource CadCanvasBrush}"/>
                                <Canvas x:Name="CadContent">
                                    <Canvas.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="CadZoomTransform" ScaleX="1" ScaleY="1"/>
                                            <TranslateTransform x:Name="CadPanTransform" X="0" Y="0"/>
                                        </TransformGroup>
                                    </Canvas.RenderTransform>

                                    <ItemsControl ItemsSource="{Binding CadLimitAreas}" IsHitTestVisible="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Polygon Points="{Binding Points}"
                                                         Fill="{Binding Fill}"
                                                         Stroke="{Binding Stroke}"
                                                         StrokeDashArray="{Binding StrokeDashArray}">
                                                    <Polygon.StrokeThickness>
                                                        <MultiBinding Converter="{StaticResource InverseZoomStrokeThicknessConverter}">
                                                            <Binding Path="StrokeThickness"/>
                                                            <Binding RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" Path="CadDisplayZoom"/>
                                                        </MultiBinding>
                                                    </Polygon.StrokeThickness>
                                                </Polygon>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding CadAxisLines}" IsHitTestVisible="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Line X1="{Binding X1}"
                                                      Y1="{Binding Y1}"
                                                      X2="{Binding X2}"
                                                      Y2="{Binding Y2}"
                                                      Stroke="{Binding Stroke}"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Opacity="{Binding Opacity}">
                                                    <Line.StrokeThickness>
                                                        <MultiBinding Converter="{StaticResource InverseZoomStrokeThicknessConverter}">
                                                            <Binding Path="StrokeThickness"/>
                                                            <Binding RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" Path="CadDisplayZoom"/>
                                                        </MultiBinding>
                                                    </Line.StrokeThickness>
                                                </Line>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Path Data="{Binding CadPreviewGeometry}"
                                          Stroke="DeepSkyBlue"
                                          StrokeThickness="0.65"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          IsHitTestVisible="False"/>
                                    <Path Data="{Binding CadEngravePreviewGeometry}"
                                          Stroke="DodgerBlue"
                                          StrokeThickness="0.65"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          IsHitTestVisible="False"/>
                                    <Path Data="{Binding CadCutPreviewGeometry}"
                                          Stroke="OrangeRed"
                                          StrokeThickness="0.65"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          IsHitTestVisible="False"/>
                                    <Path Data="{Binding CadSelectionOverlayGeometry}"
                                          Stroke="{Binding CadSelectionOverlayStroke}"
                                          StrokeThickness="1.6"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          IsHitTestVisible="False"/>

                                    <ItemsControl ItemsSource="{Binding CadAxisLabels}" IsHitTestVisible="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Text}"
                                                           Foreground="{Binding Foreground}"
                                                           FontSize="14"
                                                           FontWeight="Bold"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding CadTrackingPoints}" IsHitTestVisible="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <TranslateTransform X="{Binding X}" Y="{Binding Y}"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid x:Name="TrackingMarker" ToolTip="{Binding ToolTip}">
                                                    <Grid.Width>
                                                        <MultiBinding Converter="{StaticResource InverseZoomStrokeThicknessConverter}">
                                                            <Binding Path="Size"/>
                                                            <Binding RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" Path="CadDisplayZoom"/>
                                                        </MultiBinding>
                                                    </Grid.Width>
                                                    <Grid.Height>
                                                        <MultiBinding Converter="{StaticResource InverseZoomStrokeThicknessConverter}">
                                                            <Binding Path="Size"/>
                                                            <Binding RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" Path="CadDisplayZoom"/>
                                                        </MultiBinding>
                                                    </Grid.Height>
                                                    <Grid.RenderTransform>
                                                        <TranslateTransform X="{Binding ActualWidth, ElementName=TrackingMarker, Converter={StaticResource NegativeHalfConverter}}"
                                                                            Y="{Binding ActualHeight, ElementName=TrackingMarker, Converter={StaticResource NegativeHalfConverter}}"/>
                                                    </Grid.RenderTransform>
                                                     <Ellipse Fill="{Binding Fill}"
                                                              Stroke="{Binding Stroke}">
                                                         <Ellipse.StrokeThickness>
                                                             <MultiBinding Converter="{StaticResource InverseZoomStrokeThicknessConverter}">
                                                                 <Binding Source="{StaticResource BaseStrokeThickness}"/>
                                                                 <Binding RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" Path="CadDisplayZoom"/>
                                                             </MultiBinding>
                                                         </Ellipse.StrokeThickness>
                                                     </Ellipse>
                                                    <TextBlock Text="{Binding Label}"
                                                               Foreground="{Binding Stroke}"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Margin="14,-16,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </Canvas>
                        </Viewbox>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="DXF Point Monitor" Style="{StaticResource PanelTitleStyle}"/>
                            <TextBlock Text="{Binding ProgramMonitorSubtitle}"
                                       Style="{StaticResource PanelSubtitleStyle}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveProgramText}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       Margin="0,0,8,0"/>
                            <Ellipse Width="12"
                                     Height="12"
                                     Fill="{Binding IsConnected, Converter={StaticResource BoolToStatusBrushConverter}}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding RunProgressText}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       Visibility="{Binding RunProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ProgressText}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                        <ProgressBar Height="8"
                                     Maximum="100"
                                     Value="{Binding RunProgressPercent, Mode=OneWay}"
                                     Visibility="{Binding RunProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                     Margin="0,5,0,0"/>
                        <ProgressBar Height="5"
                                     Maximum="100"
                                     Value="{Binding ProgressPercent}"
                                     Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                     Margin="0,4,0,0"/>
                    </StackPanel>

                    <DataGrid x:Name="ProgramGrid"
                              Grid.Row="2"
                              ItemsSource="{Binding ProgramRows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.ScrollChanged="ProgramGrid_ScrollChanged"
                              HorizontalScrollBarVisibility="Auto"
                              Margin="0,8,0,0"
                              Background="{DynamicResource PanelAltBrush}">
                        <DataGrid.RowStyle>
                            <Style TargetType="{x:Type DataGridRow}">
                                <Setter Property="MinHeight" Value="28"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Background" Value="#1E4E3A"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Run" Binding="{Binding ActiveMarker}" Width="48"/>
                            <DataGridTextColumn Header="No." Binding="{Binding Index}" Width="58"/>
                            <DataGridTextColumn Header="DXF Point" Binding="{Binding MotionType}" Width="*"/>
                            <DataGridTextColumn Header="M" Binding="{Binding MCodeValue}" Width="48"/>
                            <DataGridTextColumn Header="Speed" Binding="{Binding Speed}" Width="72"/>
                            <DataGridTextColumn Header="End X;Y" Binding="{Binding EndCoordinate}" Width="135"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
