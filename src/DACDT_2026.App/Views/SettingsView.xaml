<UserControl x:Class="DACDT_2026.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DACDT_2026;component/Views/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.12*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="DXF Processing" Style="{StaticResource PanelTitleStyle}"/>
                        <TextBlock Text="Motion and laser parameters for DXF paths" Style="{StaticResource PanelSubtitleStyle}"/>
                        <UniformGrid Columns="2" Margin="0,10,0,0">
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="Offset X (mm)" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBox Text="{Binding OffsetXInput, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="6,0,0,6">
                                <TextBlock Text="Offset Y (mm)" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBox Text="{Binding OffsetYInput, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="Travel Speed (M03 / Home) (mm/min)" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBox Text="{Binding GlobalSpeedM3Input, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="6,0,0,6">
                                <TextBlock Text="Test Area Speed (mm/min)" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBox Text="{Binding TestEngraveSpeedInput, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="Laser On Delay (M03) (ms)" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBox Text="{Binding GlobalDwellM3Input, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="6,0,0,6">
                                <TextBlock Text="Laser Off Delay (M04) (ms)" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBox Text="{Binding GlobalDwellM4Input, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="Engrave Speed (mm/min)" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBox Text="{Binding EngraveSpeedInput, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="6,0,0,6">
                                <TextBlock Text="Engrave Power (%)" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBox Text="{Binding EngravePowerInput, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="Cut Speed (mm/min)" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBox Text="{Binding CutSpeedInput, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="6,0,0,6">
                                <TextBlock Text="Cut Power (%)" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBox Text="{Binding CutPowerInput, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </UniformGrid>
                        <Button Content="Apply DXF Settings" Command="{Binding ApplyDxfSettingsCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Workspace" Style="{StaticResource PanelTitleStyle}"/>
                        <TextBlock Text="Drawing boundary used by the machine preview" Style="{StaticResource PanelSubtitleStyle}"/>
                        <UniformGrid Columns="2" Margin="0,10,0,0">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Workspace Width (mm)" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBox Text="{Binding WorkspaceWidthInput, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Workspace Height (mm)" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBox Text="{Binding WorkspaceHeightInput, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </UniformGrid>
                        <Button Content="Apply Workspace" Command="{Binding SetWorkspaceCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,8,0,0"/>
                        <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Configuration File" Style="{StaticResource PanelTitleStyle}"/>
                        <TextBlock Text="Portable machine settings file" Style="{StaticResource PanelSubtitleStyle}"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ConfigurationFilePathInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseConfigurationFileCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
